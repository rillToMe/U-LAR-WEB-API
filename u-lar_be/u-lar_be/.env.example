# u-lar backend — template konfigurasi. Copy ke `.env` lalu isi secrets:
#   copy .env.example .env   (Windows) / cp .env.example .env   (Linux)
# Key memakai __ supaya IConfiguration memetakan ke section (Section__Key).
# Nilai non-secret yang tidak ditulis di sini fallback ke appsettings.json.

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=u_lar;Username=postgres;Password=CHANGE_ME

# JWT (Key wajib >= 32 karakter)
Jwt__Key=CHANGE_ME_min_32_karakter
Jwt__Issuer=u-lar-api
Jwt__Audience=u-lar-client
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30
Jwt__AdminAccessTokenMinutes=60
Jwt__StudentAccessTokenMinutes=525600

# (Password wajib >= 8 karakter)
AdminSeed__Username=admin
AdminSeed__Password=CHANGE_ME_min_8_karakter

# --- CORS (* = semua origin, ; sebagai pemisah jika spesifik) ---
Cors__AllowedOrigins=*

MediaStorage__UploadFolder=uploads/materials
MediaStorage__RequestPath=/uploads/materials
MediaStorage__MaxFileSizeMb=3

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["*"]
  },
  "Jwt": {
    "Issuer": "u-lar-api",
    "Audience": "u-lar-client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "MediaStorage": {
    "UploadFolder": "uploads/materials",
    "RequestPath": "/uploads/materials",
    "MaxFileSizeMb": 3
  }
}
